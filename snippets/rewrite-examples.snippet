# Quantumult X Rewrite syntax reference (examples only; example.invalid is a reserved domain)
# Before uncommenting, replace this with a test endpoint you control and have verified.

[rewrite_local]
;^https?://api\.example\.invalid/v1/ping$ url reject-200
;^https?://api\.example\.invalid/v1/data$ url response-body "\"demo\":true" response-body "\"demo\":false"

[mitm]
; hostname = api.example.invalid
